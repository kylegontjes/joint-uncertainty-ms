#!/bin/sh
# Job name
#SBATCH --job-name=copy_phylogeny
# User info
#SBATCH --mail-user=kgontjes@umich.edu
#SBATCH --mail-type=BEGIN,END
#SBATCH --export=ALL
#SBATCH --partition=standard
#SBATCH --account=esnitkin1
#SBATCH --output=copy_phylogeny_curation_scripts.out
#SBATCH --nodes=1  --ntasks=1 --cpus-per-task=1 --mem=50g --time=0:05:00 

# Scripts
## SNPKIT
cd /nfs/turbo/umms-esnitkin/Project_Penn_KPC/Analysis/Phyloaware/joint-uncertainty-ms/scripts/empirical/phylogeny_curation/snpkit
cp /nfs/turbo/umms-esnitkin/Project_Penn_KPC/Sequence_data/variant_calling/2025-02-17_snpkit_Penn_KPC_ST258/snpkit_*.sh .
cp /nfs/turbo/umms-esnitkin/Project_Penn_KPC/Sequence_data/variant_calling/2025-02-17_snpkit_Penn_KPC_ST258/setup/ST258_and_second_closest_nonST258_genome.txt . 

## Phylokit
cd /nfs/turbo/umms-esnitkin/Project_Penn_KPC/Analysis/Phyloaware/joint-uncertainty-ms/scripts/empirical/phylogeny_curation/phylokit
cp -r /nfs/turbo/umms-esnitkin/Project_Penn_KPC/Sequence_data/variant_calling/2025-02-17_snpkit_Penn_KPC_ST258/output_files/2025_02_23_21_11_49_core_results/phylokit/config . 
